NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/mobilehub
JWT_SECRET=replace_with_32_plus_random_bytes_openssl_rand_hex_32
API_PORT=3000
STREAM_WS_PORT=3001
# MACHINE_ID=my-host-01   # auto-generated on first boot if not set
# EXECUTIONS_DIR=/path/to/mobile-hub-executions
# ORG_CONFIG_PATH=/path/to/mobilehub.org.yaml         # defaults to ../mobilehub.org.yaml (repo root)
# PROJECT_CONFIG_PATH=/path/to/mobilehub.project.yaml # defaults to ../mobilehub.project.yaml (repo root)
# ADB_PATH=/path/to/adb                 # defaults to `adb` on PATH
# STREAM_CAPTURE_SOURCE=synthetic       # opt-in fake frames for dev/CI with no device attached;
#                                       # anything else uses the real adb capture
