{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // Errors *inside* .d.ts files only — our own source is still fully checked.
    // Needed because a `file:`-linked package (used when developing one of the
    // extracted packages locally) is a symlink, so its own devDependency copy
    // of @types/react stays visible alongside the hoisted one and TypeScript
    // reports every React global as a duplicate identifier. Both copies are
    // the same version; the clash is resolution, not a real type conflict.
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
