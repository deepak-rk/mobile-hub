# Org-wide defaults. Copy to mobilehub.org.yaml and edit — every field is
# optional; anything omitted falls back to the platform default (see
# backend/src/config/org-config.schema.ts PLATFORM_DEFAULTS).

features:
  builds: true
  execution: true
  analytics: true
  streaming: true

build:
  provider: url # url | nexus | s3 | webhook
  nexus:
    baseUrl: https://nexus.example.com
    repository: mobile-builds
  # s3:
  #   bucket: my-org-builds
  #   region: us-east-1
  # webhook:
  #   endpoint: https://ci.example.com/hooks/mobile-hub-build

# Appium servers the hub starts for its own runs. Off by default: starting a
# server is a real side effect on the host, and an org running its own Appium
# fleet must not have this fight it — an already-listening server on the
# configured port is adopted rather than replaced.
#
# Ports are assigned from basePort upward, one per device, and then persisted
# on the device record. A port picked fresh each time can leak or race; one
# that is written down cannot.
#
# Where the servers listen is deployment wiring, not app config: set the
# HUB_APPIUM_HOST env var (default 127.0.0.1). `host:` here still applies for
# one release, with a warning.
appium:
  enabled: false
  basePort: 4723

devices:
  lockTtlMinutes: 45 # a held lock auto-releases after this long unless renewed; omit to disable expiry

automation:
  # runner decides the derived install/run commands (wdio is the one the hub
  # can build); framework decides suite discovery (cucumber reads .feature
  # files under testDir). The old single key `framework: appium` still loads
  # and means runner: wdio + framework: cucumber.
  runner: wdio
  framework: cucumber
  # Commands are derived from runner + configPath. Declare install/run only
  # to override that — a runner the hub doesn't know, or a one-off shape.
  # install: { command: npm, args: [ci] }
  #
  # Injected into the runner and redacted from run logs. The child gets an
  # allow-listed environment rather than inheriting the hub's, so anything a
  # suite needs must be declared here.
  # env:
  #   APP_ENV: staging
  configPath: wdio.conf.js
  # The runner loads its own .env from the checkout; the hub never reads one.
  testDir: test

# Applications under test (`projects:`) are declared in mobilehub.project.yaml,
# together with their build source and automation repo. They still load from
# this file for one release, with a warning.
