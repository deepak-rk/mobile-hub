# Org-wide defaults. Copy to mobilehub.org.yaml and edit — every field is
# optional; anything omitted falls back to the platform default (see
# backend/src/config/org-config.schema.ts PLATFORM_DEFAULTS).

features:
  builds: true
  execution: true
  analytics: true
  streaming: true

build:
  provider: url # url | nexus | s3 | webhook
  nexus:
    baseUrl: https://nexus.example.com
    repository: mobile-builds
  # s3:
  #   bucket: my-org-builds
  #   region: us-east-1
  # webhook:
  #   endpoint: https://ci.example.com/hooks/mobile-hub-build

devices:
  lockTtlMinutes: 45 # a held lock auto-releases after this long unless renewed; omit to disable expiry

automation:
  framework: appium
  configPath: wdio.conf.js
  envFile: .env
  testDir: test

# Applications under test, keyed by the same id that lands on an
# ExecutionRun and a Build — so config and history line up without a mapping
# table. Declaring one is what puts it in the trigger form's Project dropdown.
#
# Every field is optional and inherits from the `automation` block above, so
# `my-app: {}` is enough to make a project selectable. Declare only what
# genuinely differs.
#
# A project is the APPLICATION under test — the thing whose builds get
# installed on devices. The automation repo that tests it is NOT a project of
# its own; it is this project's `automation.repoUrl`. Listing an automation
# repo here would make the test suite look like an app you could install.
#
# Because `framework` and `configPath` are declared, the platform builds the
# install and run commands itself — an operator picks a project and a suite,
# not a shell command. Declare `automation.install` / `automation.run` only to
# override that (a framework the platform doesn't know, or a one-off shape).
projects:
  demo-app:
    displayName: Demo App
    platform: android
    automation:
      # This project has its own repo; everything else (framework, configPath,
      # envFile, testDir) is inherited from the org defaults above.
      repoUrl: https://github.com/example/demo-app-automation.git

  checkout:
    displayName: Checkout
    platform: ios
    automation:
      repoUrl: https://github.com/example/checkout-automation.git
      testDir: e2e
      configPath: wdio.ios.conf.js
