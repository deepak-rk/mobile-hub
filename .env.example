# Copy to .env and fill in values before running docker compose
# Generate JWT_SECRET with: openssl rand -hex 32

JWT_SECRET=replace_with_32_plus_random_bytes

# Shared secret every device agent must present. Required in production.
# Generate with: openssl rand -hex 32
AGENT_TOKEN=replace_with_32_plus_random_bytes

# Optional overrides (defaults shown)
# API_PORT=3000
# STREAM_WS_PORT=3001
# MACHINE_ID=my-host-01
# VITE_API_URL=http://localhost:3000
# VITE_STREAM_WS_URL=ws://localhost:3001
